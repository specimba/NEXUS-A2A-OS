# ─── NEXUS OS · Environment Template ───
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# Database (SQLite for local dev, swap for Postgres/Supabase in prod)
DATABASE_URL=file:./db/custom.db

# Encryption (generate with: openssl rand -hex 32)
ENCRYPTION_SECRET=

# ─── AI Provider Keys ───
OPENAI_API_KEY=
