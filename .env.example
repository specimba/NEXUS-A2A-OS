# ─── NEXUS OS · Environment Template ───
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# Database (SQLite for local dev, swap for Postgres/Supabase in prod)
DATABASE_URL=file:../db/custom.db

# Encryption (generate with: openssl rand -hex 32)
ENCRYPTION_SECRET=

# ─── AI Provider Keys ───
OPENAI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
CODESTRAL_API_KEY=
FIREWORKS_API_KEY=
NVIDIA_API_KEY=
SAMBANOVA_API_KEY=
SILICONFLOW_API_KEY=
ZAI_API_KEY=

# ─── Tooling / Agent Keys ───
# ─── OpenRouter (Free models available) ───
OPENROUTER_API_KEY=your-openrouter-key-here

# ─── NVIDIA NIM (Free tier with 1K credits) ───
NVIDIA_API_KEY=nvapi-your-nvidia-key

# ─── Groq (Free: 30 RPM LPU inference) ───
GROQ_API_KEY=your-groq-key-here

# ─── Kilo Code ───
KILOCODE_API_KEY=your-kilocode-jwt

# ─── OpenCode ───
OPENCODE_API_KEY=sk-your-opencode-key

# ─── SambaNova (Free tier) ───
SAMBANOVA_API_KEY=your-sambanova-key

# ─── OpenAI (May have 0 credits — free models only) ───
OPENAI_API_KEY=sk-proj-your-openai-key

# ─── Cerebras (Free: CS-3 wafer-scale inference) ───
CEREBRAS_API_KEY=csk-your-cerebras-key

# ─── Fireworks (Free serverless — $1 credits) ───
FIREWORKS_API_KEY=fw_your-fireworks-key

# ─── SiliconFlow (Free tier) ───
SILICONFLOW_API_KEY=sk-your-siliconflow-key

# ─── Composio (Tool integration) ───
COMPOSIO_API_KEY=ak_your-composio-key

# ─── Mistral (Experiment plan: 2 RPM, 1B tok/month) ───
MISTRAL_API_KEY=your-mistral-key

# ─── Codestral (Code specialist: 30 RPM) ───
CODESTRAL_API_KEY=your-codestral-key

# ─── Mistral Studio ───
MISTRAL_STUDIO_KEY=your-mistral-studio-key
CODESTRAK_KEY=your-codestrak-key
CODESTRAL_COMPLETION_ENDPOINT=https://codestral.mistral.ai/v1/fim/completions
CODESTRAL_CHAT_ENDPOINT=https://codestral.mistral.ai/v1/chat/completions

