{
  "version": 1,
  "description": "npm registry access policy",
  "trust_level": "CAUTION",
  "network_policies": [
    {
      "name": "npm_registry",
      "enforcement": "allow",
      "endpoints": [
        {"host": "registry.npmjs.org", "port": 443, "protocol": "https"}
      ],
      "rules": [
        {"method": "GET", "path": "/*", "description": "Package read"},
        {"method": "GET", "path": "/-/v1/search", "description": "Search"}
      ]
    }
  ]
}
