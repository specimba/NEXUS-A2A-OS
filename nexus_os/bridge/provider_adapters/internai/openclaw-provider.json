{
  "schema": "nexus.openclaw-provider.v1",
  "surface": "zo-openclaw",
  "onboardProviderType": "custom-openai-compatible",
  "provider": {
    "id": "internai",
    "name": "Intern AI Shanghai",
    "baseURL": "${INTERN_BASE_URL:-https://chat.intern-ai.org.cn/api/v1}",
    "apiKeyEnvOrder": ["INTERN_CLAW_API_KEY", "INTERN_ZO_API_KEY", "INTERN_API_KEY_2", "INTERN_API_KEY"],
    "chatPath": "/chat/completions"
  },
  "models": {
    "agent": "intern-s2-preview",
    "general": "intern-latest",
    "vision": "internvl3.5-latest"
  },
  "zoSecrets": [
    "INTERN_CLAW_API_KEY",
    "INTERN_ZO_API_KEY",
    "INTERN_API_KEY_2",
    "INTERN_BASE_URL"
  ],
  "requestDefaults": {
    "stream": false,
    "temperature": 0.2,
    "max_tokens": 4096,
    "thinking_mode": true
  },
  "requestRules": {
    "strip": ["stop"],
    "toolsFormat": "openai",
    "retry429": "cooldown"
  }
}

