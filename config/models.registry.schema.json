{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NEXUS canonical model registry",
  "type": "object",
  "required": [
    "version",
    "providers",
    "models"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 3
    },
    "_comment": {
      "type": "string"
    },
    "providers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "keyRef",
          "status"
        ],
        "properties": {
          "keyRef": {
            "type": [
              "string",
              "null"
            ],
            "description": "apiKeys slug in ~/.modelrelay.json — NEVER a key value"
          },
          "baseUrl": {
            "type": "string",
            "pattern": "^https?://"
          },
          "chatPath": {
            "type": "string"
          },
          "modelsPath": {
            "type": "string"
          },
          "apiFormat": {
            "type": "string"
          },
          "authHeader": {
            "type": "string"
          },
          "authScheme": {
            "type": "string"
          },
          "discoverModels": {
            "type": "boolean"
          },
          "status": {
            "enum": [
              "active",
              "suspended",
              "deprecated",
              "pending_operator"
            ]
          },
          "priority": {
            "type": "integer",
            "minimum": 0
          },
          "quota": {
            "type": "object",
            "required": [
              "windows",
              "tokens",
              "metering",
              "credit",
              "confidence",
              "degradation"
            ],
            "properties": {
              "windows": {
                "type": "object",
                "required": ["rps", "rpm", "rph", "rpd"],
                "additionalProperties": { "type": ["integer", "null"] }
              },
              "tokens": {
                "type": "object",
                "required": ["tpm", "tph", "tpd", "monthly"],
                "additionalProperties": { "type": ["integer", "null"] }
              },
              "concurrent": { "type": ["integer", "null"] },
              "burst": { "type": ["integer", "null"] },
              "metering": {
                "enum": ["requests", "tokens", "neurons", "gpu_time", "credits"]
              },
              "credit": {
                "type": "object",
                "properties": {
                  "trial_usd": { "type": ["number", "null"] },
                  "min_recharge_usd": { "type": ["number", "null"] },
                  "permanent_tier_rule": { "type": ["string", "null"] }
                },
                "additionalProperties": false
              },
              "confidence": {
                "enum": ["HIGH", "MEDIUM", "LOW", "CONFLICTED"]
              },
              "degradation": {
                "enum": ["hard_fail", "silent", "dynamic_throttle", "opaque"]
              },
              "notes": { "type": "string" }
            },
            "additionalProperties": false
          },
          "outputLicense": {
            "$ref": "#/$defs/outputLicense"
          },
          "allowedLanes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "provider",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "context": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1024
          },
          "maxOutput": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "free": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "tier": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 100
          },
          "capabilities": {
            "type": "object",
            "properties": {
              "thinking": {
                "type": "boolean"
              },
              "thinkingBudget": {
                "type": "boolean"
              },
              "tools": {
                "type": "boolean"
              },
              "vision": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          },
          "roles": {
            "type": "array",
            "items": {
              "enum": [
                "guard",
                "intent",
                "math",
                "code",
                "reasoning",
                "teacher",
                "frontier",
                "drafter",
                "judge",
                "fast"
              ]
            }
          },
          "lanes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "enum": [
              "active",
              "suspended",
              "deprecated",
              "unknown",
              "pending_operator"
            ]
          },
          "notes": {
            "type": "string"
          },
          "constraints": {
            "type": "object",
            "properties": {
              "maxConcurrent": {
                "type": "integer",
                "minimum": 1
              },
              "noParallelSubagents": {
                "type": "boolean"
              },
              "rpmHint": {
                "type": "integer",
                "minimum": 1
              }
            },
            "additionalProperties": false
          },
          "outputLicense": {
            "$ref": "#/$defs/outputLicense"
          }
        },
        "additionalProperties": false
      }
    },
    "priorityTiers": {
      "type": "object"
    },
    "teams": {
      "type": "object"
    },
    "providerQuirks": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["id", "appliesTo", "kind", "action", "confidence"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "appliesTo": {
              "type": "array",
              "items": { "type": "string" },
              "minItems": 1
            },
            "kind": {
              "enum": [
                "tool_calling_broken",
                "silent_degradation",
                "dollar_then_dead",
                "no_free_tier",
                "dynamic_throttle",
                "intermittent_hang",
                "silent_rename",
                "function_lockout",
                "request_param_required"
              ]
            },
            "action": { "type": "string", "minLength": 1 },
            "confidence": {
              "enum": ["HIGH", "MEDIUM", "LOW", "CONFLICTED"]
            },
            "notes": { "type": "string" }
          },
          "additionalProperties": false
        }
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "outputLicense": {
      "type": "object",
      "required": ["class", "basis"],
      "properties": {
        "class": {
          "enum": ["permissive", "restricted", "unknown"]
        },
        "basis": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}
