          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "properties": {
                    "content_included": {
                      "type": "boolean"
                    },
                    "files": {
                      "items": {
                        "additionalProperties": true,
                        "properties": {
                          "available": {
                            "type": "boolean"
                          },
                          "bytes": {
                            "type": "integer"
                          },
                          "modified_at": {
                            "type": "string"
                          },
                          "name": {
                            "type": "string"
                          },
                          "sha256": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "name",
                          "available"
                        ],
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "generated_at": {
                      "type": "string"
                    },
                    "schema": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "schema",
                    "generated_at",
                    "content_included",
                    "files"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "SageBearerAuth": []
          }
        ],
        "summary": "Read grounding metadata",
        "tags": [
          "nexus-sage"
        ],
        "x-nexus-authority": "sense-propose-witness",
        "x-nexus-execution-allowed": false
      }
    },
    "/api/sage/v1/health": {
      "get": {
        "description": "Confirm the separately authenticated Brain-plane ingress is available. This operation does not grant execution authority.",
        "operationId": "sage_health_api_sage_v1_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "properties": {
                    "execution_allowed": {
                      "type": "boolean"
                    },
                    "mode": {
                      "enum": [
                        "observe_only",
                        "proposal_write"
                      ],
                      "type": "string"
                    },
                    "ok": {
                      "type": "boolean"
                    },
                    "plane": {
                      "enum": [
                        "brain-governance"
                      ],
                      "type": "string"
                    },
                    "service": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "ok",
                    "service",
                    "plane",
                    "mode",
                    "execution_allowed"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "SageBearerAuth": []
          }
        ],
        "summary": "Check SAGE ingress health",
        "tags": [
          "nexus-sage"
        ],
        "x-nexus-authority": "sense-propose-witness",
        "x-nexus-execution-allowed": false
      }
    },
    "/api/sage/v1/jobs": {
      "post": {
        "description": "Create an idempotent proposal receipt in pending_review state. This operation cannot execute, approve, retry, or close work.",
        "operationId": "submit_sage_job_api_sage_v1_jobs_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "description": "Submit exactly one allowlisted proposal workflow. Match parameters to workflow_type and do not mix fields between workflows: grounding_audit requires files and optionally accepts verify_hashes; evidence_search requires query and optionally accepts sources and max_results; model_health_snapshot optionally accepts providers and include_unverified; parallel_audit_proposal requires objective and domains and optionally accepts max_agents. The server rejects mismatched or extra fields.",
                "properties": {
                  "idempotency_key": {
                    "description": "Caller-generated stable key. Reuse only when replaying the exact same proposal payload.",
                    "maxLength": 128,
                    "minLength": 8,
                    "type": "string"
                  },
                  "parameters": {
                    "additionalProperties": false,
                    "description": "Workflow-specific parameters. grounding_audit: files (required), verify_hashes. evidence_search: query (required), sources, max_results. model_health_snapshot: providers, include_unverified. parallel_audit_proposal: objective and domains (required), max_agents.",
                    "properties": {
                      "domains": {
                        "description": "Required only for parallel_audit_proposal.",
                        "items": {
                          "type": "string"
                        },
                        "maxItems": 8,
                        "minItems": 1,
                        "type": "array"
                      },
                      "files": {
                        "description": "Required only for grounding_audit.",
                        "items": {
                          "enum": [
                            "NEXUS_MANIFEST.md",
                            "01_PROJECT_STATE.md",
                            "knowledge.md",
                            "AGENTS.md"
                          ],
                          "type": "string"
                        },
                        "maxItems": 4,
                        "minItems": 1,
                        "type": "array"
                      },
                      "include_unverified": {
                        "default": true,
                        "description": "Optional for model_health_snapshot.",
                        "type": "boolean"
                      },
                      "max_agents": {
                        "default": 3,
                        "description": "Optional for parallel_audit_proposal.",
                        "maximum": 4,
                        "minimum": 1,
                        "type": "integer"
                      },
                      "max_results": {
                        "default": 10,
                        "description": "Optional for evidence_search.",
                        "maximum": 50,
                        "minimum": 1,
                        "type": "integer"
                      },
                      "objective": {
                        "description": "Required only for parallel_audit_proposal.",
                        "maxLength": 4000,
                        "minLength": 1,
                        "type": "string"
                      },
                      "providers": {
                        "description": "Optional for model_health_snapshot.",
                        "items": {
                          "type": "string"
                        },
                        "maxItems": 20,
                        "type": "array"
                      },
                      "query": {
                        "description": "Required only for evidence_search.",
                        "maxLength": 500,
                        "minLength": 1,
                        "type": "string"
                      },
                      "sources": {
                        "description": "Optional for evidence_search.",
                        "items": {
                          "enum": [
                            "grounding",
                            "audit",
                            "continuity",
                            "archivist"
                          ],
                          "type": "string"
                        },
                        "maxItems": 4,
                        "type": "array"
                      },
                      "verify_hashes": {
                        "default": true,
                        "description": "Optional for grounding_audit.",
                        "type": "boolean"
                      }
                    },
                    "type": "object"
                  },
                  "source_msg_id": {
                    "description": "Optional external correlation identifier; omit when unavailable.",
                    "maxLength": 128,
                    "type": "string"
                  },
                  "workflow_type": {
                    "description": "The allowlisted proposal workflow whose parameter rules apply.",
                    "enum": [
                      "grounding_audit",
                      "evidence_search",
                      "model_health_snapshot",
                      "parallel_audit_proposal"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "idempotency_key",
                  "workflow_type",
                  "parameters"
                ],
                "title": "Governed SAGE proposal job",
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "properties": {
                    "approval_state": {
                      "type": "string"
                    },
                    "created_at": {
                      "type": "string"
                    },
                    "execution_allowed": {
                      "type": "boolean"
                    },
                    "expires_at": {
                      "type": "string"
                    },
                    "job_id": {
                      "type": "string"
                    },
                    "proposal_only": {
                      "type": "boolean"
                    },
                    "receipt_id": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    },
                    "updated_at": {
                      "type": "string"
                    },
                    "workflow_type": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "receipt_id",
                    "job_id",
                    "workflow_type",
                    "status",
                    "proposal_only",
                    "execution_allowed",
                    "approval_state",
                    "created_at",
                    "updated_at",
                    "expires_at"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "SageBearerAuth": []
          }
        ],
        "summary": "Submit a governed proposal job",
        "tags": [
          "nexus-sage"
        ],
        "x-nexus-authority": "sense-propose-witness",
        "x-nexus-execution-allowed": false
      }
    },
    "/api/sage/v1/jobs/{job_id}": {
