                    "job_id": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    },
                    "updated_at": {
                      "type": "string"
                    },
                    "workflow_type": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "job_id",
                    "workflow_type",
                    "status",
                    "execution_allowed"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "SageBearerAuth": []
          }
        ],
        "summary": "Read a proposal job receipt",
        "tags": [
          "nexus-sage"
        ],
        "x-nexus-authority": "sense-propose-witness",
        "x-nexus-execution-allowed": false
      }
    },
    "/api/sage/v1/model-cards": {
      "get": {
        "description": "Return the canonical Model Arena projection without provider errors, credentials, or routing secrets.",
        "operationId": "sage_model_cards_api_sage_v1_model_cards_get",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 20,
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "properties": {
                    "generated_at": {
                      "type": "string"
                    },
                    "models": {
                      "items": {
                        "additionalProperties": true,
                        "properties": {
                          "label": {
                            "type": "string"
                          },
                          "model_id": {
                            "type": "string"
                          },
                          "provider_key": {
                            "type": "string"
                          }
                        },
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "projection_schema_version": {
                      "type": "string"
                    },
                    "returned": {
                      "type": "integer"
                    },
                    "schema": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "schema",
                    "models",
                    "returned"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "SageBearerAuth": []
          }
        ],
        "summary": "Read sanitized model evidence",
        "tags": [
          "nexus-sage"
        ],
        "x-nexus-authority": "sense-propose-witness",
        "x-nexus-execution-allowed": false
      }
    }
  },
  "servers": [
    {
      "description": "Replace only after the governed HTTPS ingress is approved",
      "url": "https://sage-gateway.invalid"
